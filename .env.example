# Public values; copy to .env.local for Next.js, or .env for Compose.
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional API origin; empty uses the same origin as the Next.js application.
NEXT_PUBLIC_API_URL=
# Server-only: comma-separated origins allowed to call the API cross-origin.
CORS_ORIGINS=http://localhost:5173
# Optional public Supabase configuration for the road editor and private scenarios.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Existing project: bcvzhegvjzujlgfnbwfg (eu-west-3). No credentials needed in Phase 1.
